APP_NAME=Timesheet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=single
LOG_LEVEL=debug

# New LOCAL database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=timesheet
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Jira Cloud: create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://parextech.atlassian.net/
JIRA_AUTH=basic
JIRA_EMAIL=
JIRA_API_TOKEN=

# Google Form auto-fill (defaults are in config/timesheet.php)
GOOGLE_FORM_URL=
GOOGLE_FORM_NAME="01 - test user"
GOOGLE_FORM_HEADLESS=false
GOOGLE_FORM_DRY_RUN=false
# NODE_BINARY=/opt/homebrew/bin/node
